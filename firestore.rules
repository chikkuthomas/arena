rules_version = '2';

// Arena security rules (Stage 1).
// Anyone signed in (even anonymously, by picking a name) can read rooms and
// messages and post their own. Nobody can post as someone else, and only a
// room's creator can delete it. Tighten these further in later stages when we
// add moderation.
service cloud.firestore {
  match /databases/{database}/documents {

    // A signed-in user is one who has gone through the name screen.
    function signedIn() {
      return request.auth != null;
    }

    // Banned by the admin (adminUsers Cloud Function writes banned/{uid}).
    // Checked on every Arena write so a ban bites immediately, even while the
    // user's current session token is still valid.
    function notBanned() {
      return !exists(/databases/$(database)/documents/banned/$(request.auth.uid));
    }

    // Admin-only ban list. Written by Cloud Functions (which bypass rules).
    match /banned/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    // App config, e.g. the admin's "topic of the day" override at
    // config/dailyOverride. Everyone signed in reads it (each phone applies the
    // override to its daily push); only the admin account may write it.
    // email_verified is required too: an unverified token must never be able to
    // claim the admin address.
    match /config/{doc} {
      allow read: if signedIn();
      allow write: if signedIn()
                   && request.auth.token.email == 'cryptork97@gmail.com'
                   && request.auth.token.email_verified == true;
    }

    // Moderation reports. Anyone signed in can file one; for safety nobody can
    // read or change them from the app (review them in the Firebase console).
    match /reports/{reportId} {
      allow create: if signedIn() && notBanned()
                    && request.resource.data.reporterId == request.auth.uid;
      allow read, update, delete: if false;
    }

    // Each person's profile doc — they may only write their own.
    match /users/{userId} {
      allow read: if signedIn();
      allow write: if signedIn() && request.auth.uid == userId;

      // Everything under a user's own uid (joinedRooms, hiddenRooms — see
      // RoomService) is private to them. Load-bearing: the app reads and
      // writes those subcollections directly.
      match /{document=**} {
        allow read, write: if signedIn() && request.auth.uid == userId;
      }
    }

    // Debate rooms.
    match /rooms/{roomId} {
      allow read: if signedIn();
      // Create only with yourself as the creator.
      allow create: if signedIn() && notBanned()
                    && request.resource.data.createdBy == request.auth.uid;
      // Updates are limited to the activity counters that sending a message
      // bumps (see RoomService.sendMessage) — and nothing else.
      //
      // This MUST be an allowlist, not a denylist. Pinning only
      // createdBy/name/topic used to leave every other field writable by any
      // signed-in user, which let an attacker flip `isPrivate` to false on
      // someone else's private room (verifyRoomPassword returns ok for a
      // non-private room, so that unlocked it for everyone) or rewrite its
      // joinCode. The room's creator changes settings via Cloud Functions,
      // which bypass these rules, so no client needs wider write access.
      allow update: if signedIn() && notBanned()
                    && request.resource.data.diff(resource.data)
                         .affectedKeys().hasOnly(['lastActivity', 'messageCount']);
      // Only the creator can delete their room.
      allow delete: if signedIn() && resource.data.createdBy == request.auth.uid;

      // Messages inside a room.
      match /messages/{messageId} {
        // A reaction edit may only touch the caller's own uid key. Split in two
        // because older messages predate the `reactions` field (Message.fromDoc
        // still defaults it to {}), and calling diff() on a missing map is an
        // evaluation error — which would deny reacting to any legacy message.
        function changesOnlyMyExistingReaction() {
          return ('reactions' in resource.data)
                 && request.resource.data.reactions
                      .diff(resource.data.reactions)
                      .affectedKeys().hasOnly([request.auth.uid]);
        }
        function addsOnlyMyFirstReaction() {
          return !('reactions' in resource.data)
                 && request.resource.data.reactions
                      .keys().hasOnly([request.auth.uid]);
        }

        allow read: if signedIn();
        // You may only post as yourself. The size caps are abuse limits, not UI
        // limits: the chat field is unbounded, but a direct API caller could
        // otherwise write multi-hundred-KB docs (Firestore allows ~1MiB) and
        // run up read costs for everyone in the room. Generous on purpose.
        allow create: if signedIn() && notBanned()
                      && request.resource.data.senderId == request.auth.uid
                      && request.resource.data.text is string
                      && request.resource.data.text.size() <= 5000
                      && request.resource.data.createdAt == request.time;
        // Anyone may react, but only under their OWN uid key: the client writes
        // `reactions.<myUid>` (see RoomService.toggleReaction), so the only
        // reaction entry a request may add/change/remove is its own. Without
        // the per-key check, `hasOnly(['reactions'])` let any user overwrite
        // the whole map — forging or wiping everyone else's reactions.
        // The message's own author may also edit its `text` (which sets
        // `edited`). sender/stance/createdAt can never be changed.
        allow update: if signedIn() && notBanned()
                      && (
                        (request.resource.data.diff(resource.data)
                             .affectedKeys().hasOnly(['reactions'])
                         && (changesOnlyMyExistingReaction()
                             || addsOnlyMyFirstReaction()))
                        || (resource.data.senderId == request.auth.uid
                            && request.resource.data.diff(resource.data)
                                 .affectedKeys().hasOnly(['text', 'edited'])
                            // Same abuse cap as create — otherwise an edit is a
                            // way around it.
                            && request.resource.data.text is string
                            && request.resource.data.text.size() <= 5000)
                      );
        // You may delete your own message (used by moderation later).
        allow delete: if signedIn()
                      && resource.data.senderId == request.auth.uid;
      }

      // Server-only: a private room's salted password hash. Clients can NEVER
      // read it (verification is done by the verifyRoomPassword Cloud Function);
      // only the room's creator may write it.
      match /secure/{doc} {
        allow read: if false;
        allow write: if signedIn()
          && get(/databases/$(database)/documents/rooms/$(roomId))
               .data.createdBy == request.auth.uid;
      }

      // "Who won?" votes — one document per user. Anyone signed in can read the
      // tally; you may only cast or change your own vote.
      match /votes/{voterId} {
        allow read: if signedIn();
        allow write: if signedIn() && notBanned() && request.auth.uid == voterId;
      }

      // Who has the 🔔 bell on for this room (notifyRoomOnNewMessage reads this
      // to know who to write a notification-history doc for). One doc per uid;
      // you may only create/remove your own.
      match /notifySubscribers/{uid} {
        allow read: if signedIn();
        allow write: if signedIn() && request.auth.uid == uid;
      }

      // Who has taken part in this room (opened it and not explicitly left) —
      // the "trending" re-engagement push fans out to these uids. Same
      // own-doc-only rule as notifySubscribers.
      match /participants/{uid} {
        allow read: if signedIn();
        allow write: if signedIn() && request.auth.uid == uid;
      }
    }

    // Admin broadcasts — one doc per broadcastTopic call, read by everyone so
    // the notifications screen can list them. Only the Cloud Function (Admin
    // SDK, bypasses rules) ever writes one.
    match /broadcasts/{broadcastId} {
      allow read: if signedIn();
      allow write: if false;
    }
  }
}
